        <!-- Notificações Popup -->
    <div id="notification-container"></div>

      <script type="text/javascript">
      // Sistema de Notificações (menos intrusivo)
      const names = [
        "Alessandro Silva", "Carlos Eduardo", "João Pedro", "Rafael Santos",
        "Bruno Costa", "Felipe Oliveira", "Gustavo Lima", "Lucas Almeida",
        "Thiago Ferreira", "Diego Rocha", "Marcelo Souza", "André Pereira",
        "Roberto Martins", "Fernando Gomes", "Paulo Henrique", "Mateus Silva",
        "Gabriel Santos", "Leonardo Costa", "Ricardo Barbosa", "Julio César",
        "Rodrigo Alves", "Vinicius Lima", "Fabio Nascimento", "Eduardo Santos"
      ];

      // Planos exibidos nas notificações
      const eligiblePlans = ["1 Ano", "Super Combo"];

      // Controle de mute (persistente por localStorage)
      let notifMuted = false;
      try { notifMuted = localStorage.getItem('notifMuted') === '1'; } catch (e) {}

      // Cria e mostra uma notificação
      function createNotification(name, plan, timeAgo) {
        const container = document.getElementById('notification-container');
        if (!container) return;
        if (notifMuted) return;
        // Exibe no máximo uma por vez
        if (container.children.length > 0) return;

        const notification = document.createElement('div');
        notification.style.cssText = `
          background: #fff7f3; /* creme alaranjado do site */
          color: #7c2d12;      /* texto marrom/alaranjado usado nos chips */
          padding: 10px 12px;
          border-radius: 10px;
          margin-top: 8px;
          box-shadow: 0 10px 24px rgba(255, 107, 61, 0.12);
          font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
          font-size: 13px;
          line-height: 1.35;
          transform: translateX(340px);
          transition: transform 0.28s ease;
          border: 1px solid #f5b490; /* mesmo tom das bordas de planos */
          min-width: 260px;
          max-width: 320px;
          position: relative;
          cursor: pointer;
        `;

        notification.innerHTML = `
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 8px; height: 8px; background: #ff6b3d; border-radius: 999px;"></div>
            <div>
              <strong>${name}</strong> assinou <span style="display:inline-block;padding:2px 8px;border-radius:999px;background:#fff1e6;color:#b45309;font-weight:700;">${plan}</span>
              <div style="font-size: 11px; opacity: 0.8; margin-top: 2px; color:#6b7280">${timeAgo}</div>
            </div>
          </div>
          <button aria-label="Silenciar notificações" title="Silenciar notificações" style="position:absolute;top:6px;right:8px;background:transparent;border:none;color:#b45309;font-size:16px;line-height:1;cursor:pointer">×</button>
        `;

        container.appendChild(notification);

        // Clique no X silencia todas as próximas e remove atual
        const closeBtn = notification.querySelector('button');
        if (closeBtn) {
          closeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            notifMuted = true;
            try { localStorage.setItem('notifMuted', '1'); } catch (err) {}
            notification.style.transform = 'translateX(340px)';
            setTimeout(() => {
              if (notification.parentNode) notification.parentNode.removeChild(notification);
            }, 280);
          });
        }

        // Clique no toast abre o checkout
        notification.addEventListener('click', () => {
          notification.style.transform = 'translateX(340px)';
          setTimeout(() => {
            if (notification.parentNode) notification.parentNode.removeChild(notification);
          }, 280);
          if (typeof openWiinPayCheckout === 'function') openWiinPayCheckout('supercombo');
        });

        // Animar entrada
        requestAnimationFrame(() => {
          notification.style.transform = 'translateX(0)';
        });

        // Remover após 3.5s
        setTimeout(() => {
          notification.style.transform = 'translateX(340px)';
          setTimeout(() => {
            if (notification.parentNode) notification.parentNode.removeChild(notification);
          }, 300);
        }, 3500);
      }

      function getRandomTimeAgo() {
        const times = [
          "há 2 minutos", "há 5 minutos", "há 8 minutos", "há 1 minuto",
          "há 3 minutos", "há 7 minutos", "há 4 minutos", "há 6 minutos",
          "há 10 minutos", "há 15 minutos", "agora mesmo"
        ];
        return times[Math.floor(Math.random() * times.length)];
      }

      function showRandomNotification() {
        const name = names[Math.floor(Math.random() * names.length)];
        const plan = eligiblePlans[Math.floor(Math.random() * eligiblePlans.length)];
        const timeAgo = getRandomTimeAgo();
        createNotification(name, plan, timeAgo);
      }

      // Iniciar notificações com menos frequência
      function startNotifications() {
        if (notifMuted) return;
        let shownCount = 0;
        const maxPerSession = 6;

        const scheduleNext = () => {
          if (notifMuted || shownCount >= maxPerSession) return; // limite de sessões
          const interval = 18000 + Math.floor(Math.random() * 10000); // 18–28s
          setTimeout(() => {
            // evitar empilhar se já houver uma visível
            const container = document.getElementById('notification-container');
            if (!notifMuted && container && container.children.length === 0) {
              showRandomNotification();
              shownCount++;
            }
            scheduleNext();
          }, interval);
        };

        // Primeira após 5–8s
        const firstDelay = 5000 + Math.floor(Math.random() * 3000);
        setTimeout(() => {
          const container = document.getElementById('notification-container');
          if (!notifMuted && container && container.children.length === 0) {
            showRandomNotification();
            shownCount++;
          }
          scheduleNext();
        }, firstDelay);
      }

      document.addEventListener("DOMContentLoaded", () => {
        // Iniciar sistema de notificações
        startNotifications();
        // Melhorias para reprodução de vídeo no iOS
        const video = document.querySelector(".post-video");

        if (video) {
          // Função para tentar iniciar o vídeo de várias maneiras
          const tryPlayVideo = () => {
            // Tenta reproduzir o vídeo
            const playPromise = video.play();

            if (playPromise !== undefined) {
              playPromise
                .then(() => {
                  console.log("Vídeo iniciado com sucesso");
                })
                .catch((error) => {
                  console.log("Erro ao iniciar vídeo:", error);

                  // Se falhar, tenta novamente após um pequeno atraso
                  setTimeout(() => {
                    video
                      .play()
                      .catch((e) =>
                        console.log("Tentativa adicional falhou:", e)
                      );
                  }, 300);
                });
            }
          };

          // Tenta iniciar o vídeo imediatamente
          tryPlayVideo();

          // Tenta novamente quando a página estiver totalmente carregada
          window.addEventListener("load", tryPlayVideo);

          // Tenta novamente com interação do usuário
          document.body.addEventListener(
            "touchstart",
            () => {
              video
                .play()
                .catch((e) => console.log("Falha ao iniciar com toque:", e));
            },
            { once: true }
          );

          // Verifica se o vídeo está pausado e tenta reproduzir novamente
          setInterval(() => {
            if (video.paused) {
              video
                .play()
                .catch((e) =>
                  console.log("Falha ao reiniciar vídeo pausado:", e)
                );
            }
          }, 1000);
        }

        // Benefícios do plano PREMIUM: recolhidos por padrão pra economizar
        // altura no celular; abrem quando o lead toca na setinha.
        const premiumToggle = document.getElementById("premiumToggle");
        const premiumBenefits = document.getElementById("premiumBenefits");
        if (premiumToggle && premiumBenefits) {
          premiumToggle.addEventListener("click", () => {
            const open = premiumToggle.getAttribute("aria-expanded") === "true";
            premiumToggle.setAttribute("aria-expanded", String(!open));
            premiumBenefits.hidden = open;
          });
        }

        // Promotions dropdown toggle
        const promotionsHeader = document.querySelector(".promotions-header");
        // O card do plano PREMIUM entra aqui como bloco inteiro: se só o botão
        // de compra fosse escondido, sobrava o card preto vazio com a setinha.
        const promotionsButtons = document.querySelectorAll(
          ".promotions .subscription-link, .promotions .plan-premium"
        );
        const chevron = document.querySelector(".chevron");
        let promotionsOpen = true;

        // Append current query string (UTMs) to pricing links
        const planLinks = document.querySelectorAll(
          ".pricing-panel a[href^='https://'], .footer-cta a[href^='https://']"
        );
        if (window.location.search) {
          planLinks.forEach((a) => {
            try {
              const url = new URL(a.html);
              if (url.search && url.search.length > 1) {
                // Already has params; append
                a.href = a.href + "&" + window.location.search.substring(1);
              } else {
                a.href = a.href + window.location.search;
              }
            } catch (e) {}
          });
        }

        promotionsHeader.addEventListener("click", () => {
          promotionsOpen = !promotionsOpen;

          if (promotionsOpen) {
            promotionsButtons.forEach((button) => {
              // "" devolve o display do CSS. Com "block" fixo, os planos
              // perdiam o flex e o preço saía de baixo do nome ao reabrir.
              button.style.display = "";
            });
            chevron.style.transform = "rotate(0deg)";
          } else {
            promotionsButtons.forEach((button) => {
              button.style.display = "none";
            });
            chevron.style.transform = "rotate(-90deg)";
          }
        });

        // Content tabs
        const tabs = document.querySelectorAll(".tab");
        const tabContents = document.querySelectorAll(".tab-content");

        tabs.forEach((tab) => {
          tab.addEventListener("", () => {
            // Remove active class from all tabs and contents
            tabs.forEach((t) => t.classList.remove("active"));
            tabContents.forEach((content) =>
              content.classList.remove("active")
            );

            // Add active class to clicked tab
            tab.classList.add("active");

            // Show corresponding content
            const tabId = tab.getAttribute("data-tab");
            document.getElementById(`${tabId}-content`).classList.add("active");
          });
        });

        // Media subtabs
        const subtabs = document.querySelectorAll(".subtab");

        subtabs.forEach((subtab) => {
          subtab.addEventListener("click", () => {
            // Remove active class from all subtabs
            subtabs.forEach((s) => s.classList.remove("active"));

            // Add active class to clicked subtab
            subtab.classList.add("active");
          });
        });

        // Cookie consent
        const cookieConsent = document.querySelector(".cookie-consent");
        if (cookieConsent) {
        const acceptButton = cookieConsent.querySelector("button");

        // Check if user has already accepted cookies
        if (localStorage.getItem("cookiesAccepted")) {
          cookieConsent.style.display = "none";
        }

        if (acceptButton) acceptButton.addEventListener("click", () => {
          localStorage.setItem("cookiesAccepted", "true");
          cookieConsent.style.display = "none";
        });
        }

        // Adicionar efeito de pulsar aos botões quando passar o mouse
        const outlineButtons = document.querySelectorAll(".outline-button");

        outlineButtons.forEach((button) => {
          button.addEventListener("mouseenter", () => {
            button.classList.add("pulse");
          });

          button.addEventListener("mouseleave", () => {
            button.classList.remove("pulse");
          });
        });

        // Otimização: autoplay apenas quando visível; pausa quando fora da viewport
        try {
          const feedVideos = Array.from(document.querySelectorAll('.feed-media video.locked-media'));
          if (feedVideos.length) {
            const io = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                const vid = entry.target;
                if (entry.isIntersecting && entry.intersectionRatio >= 0.3) {
                  if (vid.paused) vid.play().catch(() => {});
                } else {
                  if (!vid.paused) vid.pause();
                }
              });
            }, { threshold: [0, 0.3] });
            feedVideos.forEach(v => io.observe(v));

            // Pausa todos ao trocar de aba para reduzir CPU
            document.addEventListener('visibilitychange', () => {
              if (document.hidden) feedVideos.forEach(v => { try { v.pause(); } catch(e) {} });
            });
          }
        } catch(e) {}
      });
    </script>
    
  

  




<script src="js/wiinpay-checkout.js?v=20260901premium"></script>

<script>
// Audio automático na vitrine: unmute o vídeo mais visível na tela
(function(){
  var videos = document.querySelectorAll('.feed-media video.locked-media');
  if (!videos.length) return;

  var current = null;

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting && entry.intersectionRatio >= 0.6) {
        if (current && current !== entry.target) {
          current.muted = true;
        }
        entry.target.muted = false;
        current = entry.target;
      } else if (entry.target === current && entry.intersectionRatio < 0.4) {
        entry.target.muted = true;
        current = null;
      }
    });
  }, { threshold: [0, 0.4, 0.6, 1] });

  videos.forEach(function(v) { observer.observe(v); });
})();
</script>
</body></html>