<!DOCTYPE html><html lang="pt-BR"><head><meta http-equiv="content-type" content="text/html;charset=UTF-8">
  <title>Mel Maia</title>
  <!-- Config dinâmica (painel /admin.html): sobrescreve nome/usuário/mídias.
       Sem nada salvo no KV, a página usa os arquivos estáticos normalmente. -->
  <script>
  (function () {
    function apply(cfg) {
      if (!cfg) return;
      // atualiza só o texto inicial de um elemento, preservando filhos (ex.: selo verificado)
      function setLead(el, t) {
        if (!el) return;
        var n = el.firstChild;
        if (n && n.nodeType === 3) n.nodeValue = t + ' ';
        else el.insertBefore(document.createTextNode(t + ' '), el.firstChild);
      }
      function run() {
        if (cfg.name) {
          document.title = cfg.name;
          setLead(document.querySelector('.profile-name'), cfg.name);
          setLead(document.querySelector('.popup-profile-name'), cfg.name);
          document.querySelectorAll('.feed-name').forEach(function (e) { e.textContent = cfg.name; });
          document.querySelectorAll('.feed-avatar').forEach(function (e) { e.alt = 'Avatar da ' + cfg.name; });
          document.querySelectorAll('.verification-item span').forEach(function (e) {
            if (/Chat ao vivo com a /.test(e.textContent)) e.textContent = 'Chat ao vivo com a ' + cfg.name;
            if (/Video chamada com a /.test(e.textContent)) e.textContent = 'Video chamada com a ' + cfg.name;
          });
        }
        if (cfg.username) {
          document.querySelectorAll('.profile-username, .popup-profile-username, .feed-handle')
            .forEach(function (e) { e.textContent = cfg.username; });
        }
        if (cfg.avatar) {
          var a = document.getElementById('profileAvatar');
          if (a) a.src = cfg.avatar;
          document.querySelectorAll('.popup-profile-image img, .feed-avatar')
            .forEach(function (e) { e.src = cfg.avatar; });
        }
        if (cfg.cover) {
          document.querySelectorAll('.cover-image img, .popup-cover-image img')
            .forEach(function (e) { e.src = cfg.cover; });
        }
        [1, 2, 3].forEach(function (i) {
          var u = cfg['video' + i];
          if (!u) return;
          var v = document.querySelector('video.locked-media[data-mm-video="' + i + '"]');
          if (!v) return;
          v.src = u;
          if (cfg.cover) v.poster = cfg.cover;
          try { v.load(); } catch (e) {}
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
      else run();
    }
    fetch('/api/config', { cache: 'no-store' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(apply)
      .catch(function () {});
  })();
  </script>
  <meta http-equiv="content-type" content="text/html;charset=UTF-8">
  <!-- fbevents local removido (conflitava com o CDN do Facebook) -->

