    /* Evitar que notificações cubram o popup */
    body.popup-active #notification-container {
      display: none !important;
    }

    /* Posição e comportamento padrão das notificações */
    #notification-container {
      position: fixed !important;
      bottom: 20px !important;
      right: 20px !important;
      left: auto !important;
      max-width: 320px !important;
      z-index: 999 !important; /* abaixo do overlay do popup (9999) */
      pointer-events: none; /* não intercepta cliques */
    }

    #notification-container > div { pointer-events: auto; }
