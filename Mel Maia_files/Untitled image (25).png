  <!-- VIP gate: lead que já completou o funil vê a tela de Acesso Liberado em vez da vitrine -->
  <script>
  (function(){
    try {
      var flag = localStorage.getItem('wp_funnel_completed_v1');
      console.log('[WP] VIP gate check: wp_funnel_completed_v1=' + flag);
      if (flag === 'true') {
        document.documentElement.classList.add('wp-vip-completed');
        console.log('[WP] VIP gate ATIVO → vai mostrar tela Acesso Liberado');
      }
    } catch(e) {
      console.log('[WP] VIP gate ERRO:', e.message);
    }
  })();
  </script>
  <style>
    html.wp-vip-completed .main-container,
    html.wp-vip-completed footer,
    html.wp-vip-completed [data-hide-on-vip] { display:none !important; }
    html.wp-vip-completed #vipGateScreen { display:flex !important; }
    #vipGateScreen { display:none; }
    .vip-screen { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px 20px; background:linear-gradient(180deg,#0f0f14 0%, #1a1015 100%); font-family:'Montserrat',system-ui,sans-serif; }
    .vip-card { width:100%; max-width:420px; background:#fff; border-radius:20px; padding:36px 28px; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,0.4); }
    .vip-icon { width:84px; height:84px; margin:0 auto 18px; background:linear-gradient(135deg,#10b981,#34d399); border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:42px; box-shadow:0 8px 24px rgba(16,185,129,0.35); }
    .vip-title { font-size:28px; font-weight:800; color:#111827; margin:0 0 8px; line-height:1.2; }
    .vip-sub { font-size:15px; color:#4b5563; margin:0 0 26px; line-height:1.5; }
    .vip-cta { display:flex; align-items:center; justify-content:center; gap:10px; width:100%; padding:18px 20px; background:linear-gradient(135deg,#ff6b3d,#ff8f5f); color:#fff; font-size:18px; font-weight:800; border-radius:14px; text-decoration:none; box-shadow:0 8px 24px rgba(255,107,61,0.4); transition:transform .15s ease, box-shadow .15s ease; }
    .vip-cta:hover, .vip-cta:active { transform:translateY(-1px); box-shadow:0 12px 28px rgba(255,107,61,0.5); }
    .vip-cta i { font-size:20px; }
    .vip-meta { font-size:12px; color:#9ca3af; margin:18px 0 0; }
    .vip-buy-again { display:inline-block; margin-top:22px; font-size:12px; color:#9ca3af; text-decoration:underline; cursor:pointer; background:none; border:none; padding:6px 12px; font-family:inherit; }
    .vip-buy-again:hover { color:#6b7280; }
  </style>

  <!-- TikTok: rastreamento 100% SERVER-SIDE (Events API nas functions).
       SEM pixel client-side de propósito: o SDK do navegador reportava o
       domínio REAL desta página pro TikTok ("Connected domains") e furava o
       cloaker. Aqui só capturamos o ttclid pra repassar ao servidor (atribuição). -->
  <script>
    try {
      var _ttclid = new URLSearchParams(window.location.search).get('ttclid');
      if (_ttclid) sessionStorage.setItem('ttclid', _ttclid);
    } catch(e) {}
  </script>

